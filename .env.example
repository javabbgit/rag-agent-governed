# Copy to .env and fill in. Never commit .env.

# gateway (default) routes every call through llm-gateway-governance; direct targets any
# OpenAI-compatible endpoint. In gateway mode there is NO fallback to direct mode.
LLM_MODE=gateway

# Chat endpoint. gateway: http://localhost:4000/v1.
# direct: a cloud OpenAI-compatible endpoint, e.g. OPENAI_BASE_URL=https://api.anthropic.com/v1/
# with CHAT_MODEL=claude-haiku-5-5. The bundled Ollama serves embeddings only, not chat.
OPENAI_BASE_URL=http://localhost:4000/v1
# Gateway virtual key (direct mode: the provider key). Replace; never paste a real key into the repo.
OPENAI_API_KEY=replace-me
CHAT_MODEL=chat-cloud
EMBED_MODEL=rag-embed

# Optional: separate embeddings endpoint/key. Fall back to OPENAI_BASE_URL / OPENAI_API_KEY.
# Direct mode: embeddings go to the bundled Ollama (`make up-direct`):
#   EMBED_BASE_URL=http://localhost:11435/v1  with  EMBED_MODEL=nomic-embed-text
# EMBED_BASE_URL=
# EMBED_API_KEY=

# Embedding dimension (default 768); every vector is checked against it.
# EMBED_DIM=768

# Request timeout in seconds (default 180) and SDK retries (default 1).
# Policy/auth/allow-list/budget errors are never retried.
# LLM_TIMEOUT_S=180
# LLM_MAX_RETRIES=1

# Postgres (pgvector) started by `make up`.
# DATABASE_URL=postgresql://rag:rag@127.0.0.1:5433/rag

# Local cross-encoder reranker (compose service "reranker", `make up` does not start it; use
# `docker compose up -d reranker`). The model revision is checked against GET /info.
# RERANKER_URL=http://127.0.0.1:8081
# RERANKER_MODEL_REV=2cfc18c9415c912f9d8155881c133215df768a70
# RERANK_TIMEOUT_S=60

# Cited answers (make ask). The fallback threshold itself is read from eval/fallback/threshold.toml.
# ANSWER_PROMPT=src/rag_agent/prompts/answer_v2.md
# ANSWER_CONTEXT_K=5
# ANSWER_MAX_TOKENS=2048
# QUESTION_MAX_CHARS=1000
# ANSWER_LOG_DIR=reports/answers
# Query embedding timeout in seconds (default: LLM_TIMEOUT_S).
# EMBED_TIMEOUT_S=

# Agent defenses (D7). Comma-separated switches to turn off; any switch off also needs the ack.
# Tests and D9 runs only; never set in demos.
# AGENT_DISABLE=
# AGENT_DEFENSES_OFF_ACK=1
# Agent loop (make agent): completion cap per chat call, system prompt file, run log directory.
# AGENT_MAX_TOKENS=2048
# AGENT_PROMPT=src/rag_agent/prompts/agent_v1.md
# AGENT_LOG_DIR=reports/agent
